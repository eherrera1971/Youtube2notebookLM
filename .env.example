# --- Obligatorio ---
# API key de Anthropic (para resumir transcripciones con Claude)
ANTHROPIC_API_KEY=

# --- Opcional ---
# Modelo de Claude a usar (por defecto: claude-opus-5).
# Alternativa más barata y rápida: claude-sonnet-5
# ANTHROPIC_MODEL=claude-opus-5

# Profundidad de razonamiento: low | medium | high | xhigh | max
# (por defecto: medium). Vacío = no enviar el parámetro.
# ANTHROPIC_EFFORT=medium

# Ruta de la bóveda de Obsidian y subcarpeta destino
# OBSIDIAN_VAULT=~/Remoto
# OBSIDIAN_SUBFOLDER=4 YoutubeCeleste

# Nombre de la playlist de YouTube a procesar
# YOUTUBE_PLAYLIST=Celeste

# --- Notificaciones de error por WhatsApp (opcional) ---
# Token de Whapi.cloud (obtener en https://app.whapi.cloud)
WHAPI_TOKEN=

# Número destino (con código de país, sin +)
WHATSAPP_TO=56912345678
